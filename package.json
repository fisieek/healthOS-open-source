{
  "name": "health-os",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Osobisty system zdrowotny działający lokalnie — dane treningowe, dokumentacja medyczna i asystent AI w jednym miejscu.",
  "repository": {
    "type": "git",
    "url": "https://github.com/fisieek/healthOS-open-source.git"
  },
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "next dev --webpack -H 127.0.0.1",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "db:backup": "./scripts/db-backup.sh",
    "db:restore": "./scripts/db-restore.sh",
    "desktop:compile": "tsc electron/main.ts --outDir dist-electron --module commonjs --target es2020 --skipLibCheck --esModuleInterop",
    "desktop:dev": "npm run desktop:compile && electron dist-electron/main.js",
    "desktop:prepare": "node scripts/prepare-standalone.js",
    "desktop:build": "npm run build && npm run desktop:prepare && npm run desktop:compile && electron-builder"
  },
  "build": {
    "appId": "com.healthos.app",
    "productName": "healthOS",
    "mac": {
      "category": "public.app-category.healthcare-fitness",
      "target": [
        "dmg"
      ],
      "identity": null
    },
    "directories": {
      "output": "dist-desktop"
    },
    "files": [
      "!**/*",
      "dist-electron/**/*",
      "package.json",
      ".next/standalone/**/*",
      "prisma/migrations/**/*",
      "scripts/run-migrations.js"
    ],
    "asar": false,
    "buildDependenciesFromSource": false,
    "npmRebuild": false,
    "afterPack": "scripts/after-pack.js"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.80",
    "@ai-sdk/react": "^3.0.199",
    "@base-ui/react": "^1.4.1",
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "ai": "^6.0.197",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "next-auth": "^5.0.0-beta.32",
    "prisma": "^7.8.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-is": "^19.2.6",
    "recharts": "^3.8.1",
    "shadcn": "^4.7.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "electron": "^36.9.5",
    "electron-builder": "^26.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.22.1",
    "typescript": "^5"
  }
}
