# HealthOS Colmi Sync Configuration
# Copy this to .env and fill in your values

# Your HealthOS instance URL
HEALTHOS_URL=http://localhost:3000

# Your user ID (find it in the database or HealthOS settings)
HEALTHOS_USER_ID=

# The ingest secret (must match COLMI_INGEST_SECRET in HealthOS .env.local)
COLMI_INGEST_SECRET=

# BLE address of your Colmi ring (run: colmi_r02_util scan)
COLMI_ADDRESS=
