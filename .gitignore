# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!scripts/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/app/generated/prisma

# local file storage (dev)
/storage

# --- healthOS: dane i artefakty, które nigdy nie opuszczają dysku ---
/backups/
/context/
/scratch/
/dist-desktop/
/dist-electron/
.claude/
*.db
*.db-journal
*.db-wal
*.sqlite
*.sqlite3
*.bak
*.dmg
scripts/.venv/
scripts/.seed-manifest.json
/app/generated/
test_ai_sdk.js

# Dane demonstracyjne nie trafiaja do repozytorium publicznego —
# nie publikujemy zadnych rekordow medycznych, nawet zmyslonych.
scripts/seed-test-data.ts

# --- rzeczy niezwiazane z sama aplikacja ---
# Notatki robocze dla asystentow AI — nie trafiaja do repo.
/AGENTS.md
/CLAUDE.md
# Ustawienia edytora — sprawa kazdego dewelopera z osobna.
.vscode/
# Cache bajtkodu Pythona (powstaje przy uruchamianiu scripts/sync_garmin.py).
__pycache__/
*.pyc
