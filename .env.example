# ─── Baza danych ─────────────────────────────────────────────────────────────
# SQLite, ścieżka względna wobec katalogu projektu.
DATABASE_URL="file:./prisma/dev.db"

# ─── Uwierzytelnianie (Auth.js v5) ───────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
# Wygeneruj własny: openssl rand -base64 32
AUTH_SECRET=""
# Wymagane w produkcji, inaczej Auth.js odrzuca żądania z localhost.
AUTH_TRUST_HOST="true"

# ─── Strava (opcjonalne) ─────────────────────────────────────────────────────
# https://www.strava.com/settings/api
STRAVA_CLIENT_ID=""
STRAVA_CLIENT_SECRET=""

# ─── Google Gemini (opcjonalne) ──────────────────────────────────────────────
# Asystent AI i skanowanie etykiet suplementów.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# ─── Google Calendar (opcjonalne) ────────────────────────────────────────────
# https://console.cloud.google.com/apis/credentials
# Przekierowanie: http://localhost:3000/api/integrations/google-calendar/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── Ingest z urządzeń ───────────────────────────────────────────────────────
# Sekrety, którymi skrypty synchronizujące przedstawiają się aplikacji.
# Wygeneruj każdy osobno: openssl rand -base64 32
#
# Puste = dana synchronizacja nie działa. Endpointy ingest odmawiają obsługi bez
# ustawionego sekretu i NIE mają żadnej wartości domyślnej — celowo, żeby świeża
# instalacja nie wystawiała zapisu do bazy na wspólnym, publicznie znanym haśle.
#
# W aplikacji desktopowej nie ustawiasz tego ręcznie: Electron losuje własny
# GARMIN_INGEST_SECRET przy pierwszym uruchomieniu i trzyma go w config.json.
COLMI_INGEST_SECRET=""
GARMIN_INGEST_SECRET=""

# ─── Zadania cykliczne (opcjonalne) ──────────────────────────────────────────
# Chroni endpointy cron przed wywołaniem z zewnątrz.
CRON_SECRET=""

# ─── Hevy ────────────────────────────────────────────────────────────────────
# Klucz API Hevy podaje się w ustawieniach aplikacji, nie tutaj —
# jest zapisywany per użytkownik w tabeli DataSource.
